+static int
+neurabash_root_position (tok)
+     int tok;
+{
+  switch (tok)
+    {
+    case 0:
+    case '\n':
+    case ';':
+    case '&':
+    case '(':
+    case '{':
+    case AND_AND:
+    case OR_OR:
+    case DO:
+    case THEN:
+    case ELSE:
+    case ELIF:
+    case BANG:
+    case TIME:
+    case TIMEOPT:
+    case TIMEIGN:
+      return 1;
+    default:
+      return 0;
+    }
+}
+
+static int
+neurabash_pop_token ()
+{
+  WORD_DESC *w;
+  if (neurabash_token_queue_index >= neurabash_token_queue_count)
+    return 0;
+  w = neurabash_token_queue[neurabash_token_queue_index++];
+  if (neurabash_token_queue_index == neurabash_token_queue_count)
+    neurabash_token_queue_index = neurabash_token_queue_count = 0;
+  yylval.word = w;
+  return WORD;
+}
+
+static WORD_DESC *
+neurabash_literal_word (s)
+     const char *s;
+{
+  WORD_DESC *w;
+  w = make_bare_word (s);
+  w->flags |= W_QUOTED|W_NOSPLIT|W_NOGLOB|W_NOTILDE|W_NOPROCSUB;
+  return w;
+}
+
+static int
+neurabash_queue_jul_worker (src, root)
+     char *src;
+     int root;
+{
+  neurabash_token_queue_count = neurabash_token_queue_index = 0;
+  neurabash_token_queue[neurabash_token_queue_count++] = make_word ("neurabash-jul-worker");
+  if (root)
+    neurabash_token_queue[neurabash_token_queue_count++] = make_word ("--root");
+  neurabash_token_queue[neurabash_token_queue_count++] = make_word ("--source");
+  neurabash_token_queue[neurabash_token_queue_count++] = neurabash_literal_word (src);
+  return 0;
+}
+
+static char *
+neurabash_read_jul_source ()
+{
+  char *buf;
+  int c, p, quote, escaped, paren, bracket, brace, comment;
+  int len, size, last_nonblank;
+
+  size = 256;
+  len = 0;
+  buf = (char *)xmalloc (size);
+  quote = escaped = paren = bracket = brace = comment = 0;
+  last_nonblank = -1;
+
+#define NB_APPEND(ch) do { \
+  if (len + 2 >= size) { size += 256; buf = (char *)xrealloc (buf, size); } \
+  buf[len++] = (ch); buf[len] = '\0'; \
+  if ((ch) != ' ' && (ch) != '\t' && (ch) != '\r' && (ch) != '\n') last_nonblank = len - 1; \
+} while (0)
+
+  do c = shell_getc (1); while (c == ' ' || c == '\t');
+  if (c != EOF)
+    shell_ungetc (c);
+
+  while ((c = shell_getc (1)) != EOF)
+    {
+      if (comment)
+        {
+          if (c == '\n')
+            {
+              comment = 0;
+              if (paren == 0 && bracket == 0 && brace == 0)
+                {
+                  shell_ungetc (c);
+                  break;
+                }
+            }
+          NB_APPEND (c);
+          continue;
+        }
+      if (quote)
+        {
+          NB_APPEND (c);
+          if (escaped)
+            escaped = 0;
+          else if (c == '\\' && quote == '"')
+            escaped = 1;
+          else if (c == quote)
+            quote = 0;
+          continue;
+        }
+      if (c == '\'' || c == '"')
+        {
+          quote = c;
+          NB_APPEND (c);
+          continue;
+        }
+      if (c == '#')
+        {
+          comment = 1;
+          NB_APPEND (c);
+          continue;
+        }
+      if (c == '(') paren++;
+      else if (c == ')' && paren > 0) paren--;
+      else if (c == '[') bracket++;
+      else if (c == ']' && bracket > 0) bracket--;
+      else if (c == '{') brace++;
+      else if (c == '}' && brace > 0) brace--;
+
+      if (paren == 0 && bracket == 0 && brace == 0)
+        {
+          if (c == '|')
+            {
+              p = shell_getc (1);
+              if (p == '!')
+                {
+                  int q = shell_getc (1);
+                  if (q == '>')
+                    {
+                      NB_APPEND ('|'); NB_APPEND ('!'); NB_APPEND ('>');
+                      continue;
+                    }
+                  shell_ungetc (q);
+                }
+              shell_ungetc (p);
+              shell_ungetc (c);
+              break;
+            }
+          if (c == ';' || c == '&' || c == '<' || c == '>')
+            {
+              shell_ungetc (c);
+              break;
+            }
+          if (c == '\n')
+            {
+              int j = last_nonblank;
+              if (j >= 2 && buf[j-2] == '|' && buf[j-1] == '!' && buf[j] == '>')
+                { NB_APPEND (c); continue; }
+              shell_ungetc (c);
+              break;
+            }
+        }
+      NB_APPEND (c);
+    }
+
+#undef NB_APPEND
+  while (len > 0 && (buf[len-1] == ' ' || buf[len-1] == '\t' || buf[len-1] == '\r'))
+    buf[--len] = '\0';
+  if (len == 0)
+    {
+      free (buf);
+      return (char *)NULL;
+    }
+  return buf;
+}
